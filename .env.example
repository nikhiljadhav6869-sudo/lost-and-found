# Copy to .dev.vars for local development; run npm run setup:env to generate a secret.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Comma-separated stable account IDs, assigned by the operator after registration.
# Never grant administrator access using a self-asserted email address.
ADMIN_USER_IDS=

# Local development uses local storage. Render Free must use remote storage.
STORAGE_MODE=local
# STORAGE_MODE=remote
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=server-only-database-token
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_server-only-key
# SUPABASE_STORAGE_BUCKET=lost-found-photos
# APP_ORIGIN=https://your-service.onrender.com

# Optional locally; required for production recovery and verified signup.
# Configure BOTH together. EMAIL_FROM must be a verified Brevo sender.
# BREVO_API_KEY=server-only-email-api-key
# EMAIL_FROM=verified-sender@example.com
EMAIL_FROM_NAME=Lost & Found

# Supply only when making/restoring backups. Keep separately from the archive.
# BACKUP_PASSWORD=at-least-20-random-characters
